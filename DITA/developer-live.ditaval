<?xml version="1.0" encoding="UTF-8"?>
<val>
  <!-- developer-live.ditaval -->
  <!-- Builds the live production guide for developers -->
  <prop att="audience" val="developer"  action="include"/>
  <prop att="audience" val="merchant"   action="exclude"/>
  <prop att="platform" val="live"       action="include"/>
  <prop att="platform" val="sandbox"    action="exclude"/>
</val>
